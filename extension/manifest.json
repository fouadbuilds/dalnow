{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.1.0",
  "default_locale": "en",
  "description": "__MSG_appDescription__",
  "permissions": ["storage", "sidePanel", "alarms", "notifications"],
  "host_permissions": ["https://dal.brightspace.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "panel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/debug.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
