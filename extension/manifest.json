{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_appDescription__",
  "permissions": ["storage", "sidePanel", "alarms", "notifications"],
  "host_permissions": ["https://dal.brightspace.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://dal.brightspace.com/*"],
      "js": ["src/fuse.basic.min.js", "src/universal-search.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/DM-Sans-latin.woff2"],
      "matches": ["https://dal.brightspace.com/*"]
    }
  ],
  "commands": {
    "toggle-universal-search": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Option+K"
      },
      "description": "Open DALnow universal search"
    }
  },
  "side_panel": {
    "default_path": "panel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/debug.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
